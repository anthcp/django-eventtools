{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Django runtests.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runtests.py",
            "console": "integratedTerminal",
            "django": true, // This hint helps the debugger load Django specifics
            "args": [] // If you usually pass arguments to the script, add them here
        }
    ]
}
